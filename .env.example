# LLM — at least one provider key is required for reviews
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
# GOOGLE_THINKING_BUDGET=

# When Groq rate-limits mid-review, restart on this provider (optional)
LLM_FALLBACK_PROVIDER=google

# GitHub — strongly recommended (~5000 req/hr vs ~60 unauthenticated)
GITHUB_TOKEN=

# Agent investigation budget per review (default: 5)
# MAX_INVESTIGATIONS=5

# LOG_LEVEL=INFO
