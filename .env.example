# LLM — free tier uses Gemini by default; Groq is the automatic fallback
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
# GOOGLE_THINKING_BUDGET=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional BYO server keys (not required for free-tier Gemini + Groq fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-0

# When the primary provider rate-limits mid-review, restart on this provider (optional)
LLM_FALLBACK_PROVIDER=groq

# Per LLM request timeout in seconds (default: 180)
LLM_TIMEOUT_SECONDS=180

# GitHub — strongly recommended (~5000 req/hr vs ~60 unauthenticated)
GITHUB_TOKEN=

# Agent investigation budget per review (default: 5)
# MAX_INVESTIGATIONS=5

# LOG_LEVEL=INFO
